        "enum": [
          "PRIMARY",
          "DEGRADED"
        ]
      },
      "enabling_triggers": {
        "array": "text"
      }
    },
    "optional": {
      "gate": {
        "import_": "DeploymentAdmissionGate"
      },
      "degraded_from": "uint"
    }
  },
  "PhaseIEnvelope": {
    "fields": {
      "phase": {
        "enum": [
          "I"
        ]
      },
      "bundle": "ReferencesBundle",
      "creation_context": "CreationContext",
      "profile": "ReferencesProfile",
      "assurance_profile": {
        "import_": "MainnetAssuranceProfile"
      },
      "intent": "ReceiptIntent",
      "slot": "SelectionSlot"
    },
    "optional": {}
  },
  "PhaseITranscript": {
    "fields": {
      "input": "PhaseIEnvelope",
      "output": "PhaseIRecord"
    },
    "optional": {}
  },
  "PhaseFEnvelope": {
    "fields": {
      "phase": {
        "enum": [
          "F"
        ]
      },
      "bundle": "ReferencesBundle",
      "creation_context": "CreationContext",
      "profile": "ReferencesProfile",
      "assurance_profile": {
        "import_": "MainnetAssuranceProfile"
      },
      "phase_i_transcript": "PhaseITranscript",
      "phase_f_event_ref": {
        "import_": "EventRef"
      },
      "selected_slot": "SelectionSlot",
      "intent": "ReceiptIntent"
    },
    "optional": {}
  },
  "FixedAuditTestContract": {
    "fields": {
      "name": {
        "enum": [
          "fixed-audit-if-test-v1"
        ]
      },
      "profile_ref": "ProfileRef",
      "admission_predicate": "text",
