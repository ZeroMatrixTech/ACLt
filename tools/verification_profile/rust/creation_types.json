      "network_id": {
        "import_": "NetworkID"
      },
      "assurance_profile_ref": "VersionedRefIF",
      "assurance_profile": {
        "import_": "MainnetAssuranceProfile"
      }
    },
    "optional": {}
  },
  "VersionedRefIF": {
    "fields": {
      "id": "text",
      "version": "semver",
      "digest": "digest"
    },
    "optional": {}
  }
