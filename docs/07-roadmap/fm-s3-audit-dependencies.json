  "scope_contract": {
    "method": "REEXEC_AUDIT_ONLY",
    "profile_selection": "one fixed Profile; no selection/degradation/weakening registration",
    "claim_template_allowed": false,
    "verified_claim_spec": "OMIT_KEY_IN_PROFILE_V2",
    "eligibility_snapshot_allowed": false,
    "bounded_safety_or_liveness_parameters": false,
    "assumption_evaluation": "explicit COMPLETE(snapshot) or INVALIDATING(failure); AssumptionStateSnapshot is not EligibilitySnapshot",
    "audit_events": [
      "POSITIVE",
      "NEGATIVE",
      "TIMEOUT",
      "RESOURCE_EXHAUSTED",
      "MALFORMED_SUBMISSION",
      "ENCODING_INVALID",
      "VERIFIER_CRASH",
      "VERIFIER_NONDETERMINISM_DETECTED",
      "OBJECT_UNAVAILABLE",
      "EPOCH_STALE",
      "ASSUMPTION_REVOKED",
      "EQUIVALENCE_UNDECIDED",
      "EQUIVALENCE_RESOURCE_EXCEEDED"
    ],
    "conditions_in_priority_order": [
      "VERIFICATION_INVALIDATING",
      "EXECUTION_FAILED",
      "BUDGET_EXHAUSTED",
      "DEADLINE_REACHED",
      "EVIDENCE_EXHAUSTED"
    ],
    "terminals": [
      "UNRESOLVED",
      "FAILED",
      "FUNDING_EXHAUSTED",
      "EXPIRED"
    ],
    "default_terminal": "UNRESOLVED",
    "full_phase_contexts_required": true
  },
