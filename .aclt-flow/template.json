{
  "version": 1,
  "coverage": "schemas/verification-profile/coverage.json",
  "rules": "docs/03-protocol/verification-profile-schema.md",
  "jobs": [
    {
      "id": "workflow",
      "title": "流程工具与仓库集成",
      "command": [
        "python3",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests/workflow",
        "-v"
      ],
      "timeout_seconds": 300,
      "inputs": [
        "scripts/*.py",
        "scripts/*.sh",
        "tests/workflow/*.py",
        ".aclt-flow/template.json",
        "SINGLEHOST-SHA256SUMS",
        "WORKFLOW-SHA256SUMS",
        "Makefile"
      ],
      "required_output": [
        "re:Ran [1-9][0-9]* tests",
        "OK"
      ],
      "evidence": []
    },
    {
      "id": "model",
      "title": "精确模型验证",
      "command": [
        "python3",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests/verification_model",
        "-p",
        "test_*.py",
        "-v"
      ],
      "timeout_seconds": 300,
      "inputs": [
        "tests/verification_model/*.py",
        "tests/verification_model/*.json",
        "docs/06-research/verification-round-mathematical-model.md"
      ],
      "required_output": [
        "re:Ran [1-9][0-9]* tests",
        "OK"
      ],
      "evidence": []
    },
    {
      "id": "profile",
      "title": "验证器规则与错误输入",
      "command": [
        "python3",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests/verification_profile",
        "-p",
        "test_*.py",
        "-v"
      ],
      "timeout_seconds": 300,
      "inputs": [
        "tools/**/*.py",
        "tests/verification_profile/*.py",
        "schemas/**/*.json",
        "docs/03-protocol/verification-profile-schema.md",
        "tests/verification_profile/codec/*.json",
        "schemas/verification-profile/*.txt"
      ],
      "required_output": [
        "re:Ran [1-9][0-9]* tests",
        "OK",
        "SingleHostValidationTests"
      ],
      "evidence": []
    },
    {
      "id": "singlehost",
      "title": "严格单机资格与接纳验证",
      "command": [
        "bash",
        "experiments/aclt-minimal-verifier-state3/scripts/run-ubuntu.sh"
      ],
      "timeout_seconds": 1800,
      "inputs": [
        "experiments/aclt-minimal-verifier-state3/src/**/*.rs",
        "experiments/aclt-minimal-verifier-state3/cpp/*.cpp",
        "experiments/aclt-minimal-verifier-state3/scripts/*",
        "experiments/aclt-minimal-verifier-state3/Cargo.*",
        "experiments/aclt-minimal-verifier-state3/examples/*.txt"
      ],
      "required_output": [
        "re:PASS: [1-9][0-9]* verification cases",
        "PASS: strict local admission checks",
        "PASS: strict adversarial checks",
        "re:PASS: [1-9][0-9]* exact datasets"
      ],
      "evidence": [
        "experiments/aclt-minimal-verifier-state3/build/strict-tests.json",
        "experiments/aclt-minimal-verifier-state3/build/strict-adversarial-tests.json",
        "experiments/aclt-minimal-verifier-state3/build/differential-tests.json"
      ]
    },
    {
      "id": "multinode",
      "title": "多节点原型本地消息与接纳检查",
      "command": [
        "make",
        "test-multinode"
      ],
      "timeout_seconds": 300,
      "inputs": [
        "Makefile",
        "experiments/aclt-multinode-admission/*.py"
      ],
      "required_output": [
        "re:PASS [1-9][0-9]* local checks",
        "re:PASS [1-9][0-9]* orders / [1-9][0-9]* transitions"
      ],
      "evidence": [
        "artifacts/multinode/local-tests.json"
      ]
    },
    {
      "id": "authority",
      "title": "接纳端回滚与复制保护本地验证",
      "command": [
        "make",
        "test-authority"
      ],
      "timeout_seconds": 300,
      "inputs": [
        "Makefile",
        "experiments/aclt-authority-admission/*.py",
        "experiments/aclt-minimal-verifier-state3/cpp/worker.cpp"
      ],
      "required_output": [
        "re:Ran [1-9][0-9]* tests",
        "OK"
      ],
      "evidence": [
        "artifacts/authority/local-tests.json"
      ]
    },
    {
      "id": "claim-codec",
      "title": "候选模板/claim 编码 Python 与 Rust 对拍",
      "command": [
        "make",
        "test-claim-codec"
      ],
      "timeout_seconds": 300,
      "inputs": [
        "tools/verification_profile/codec.py",
        "tools/verification_profile/rust/*.rs",
        "tools/verification_profile/rust/*.py",
        "scripts/check-claim-codec.py",
        "tests/verification_profile/codec/*.json",
        "schemas/verification-profile/claim*",
        "docs/03-protocol/verification-profile-schema.md"
      ],
      "required_output": [
        "\"status\": \"PASS\""
      ],
      "evidence": [
        "artifacts/claim-codec/cross-language.json"
      ]
    }
  ],
  "decisions": [
    {
      "id": "completion",
      "title": "正式任务在哪一步永久结束？",
      "status": "OPEN",
      "owner": "待指定",
      "basis": "核对正式规范与本地发布规则",
      "decision": ""
    },
    {
      "id": "recovery",
      "title": "正式流程采用哪份权威记录恢复？",
      "status": "DECIDED",
      "owner": "用户（2026-10-10）",
      "basis": "用户决定断电重启不续算，并要求本轮实现与验证",
      "decision": "禁止跨启动及进程重启续算；已持久保留的资格不退还，同一逻辑主张同一本机单元最多一份接纳；允许只读审计。全局身份和网络账本另行实现。"
    },
    {
      "id": "accounting",
      "title": "正式资源账本包含哪些消耗？",
      "status": "OPEN",
      "owner": "待指定",
      "basis": "现有比较单位和文件配额只有局部覆盖",
      "decision": ""
    }
  ]
}
